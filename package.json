{
  "name": "bitling",
  "private": true,
  "version": "0.2.0",
  "description": "A tiny pixel pet that lives in the corner of your screen and reacts to your AI coding agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "demo": "node scripts/demo.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "sprites": "node scripts/render-sprites.mjs",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --test scripts/lib/agents.test.mjs scripts/lib/updates.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "gifenc": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
